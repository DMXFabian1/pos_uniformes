{
  // Intérprete del entorno virtual del proyecto (lo crea deploy/instalar-windows.ps1)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.typeCheckingMode": "basic",

  // Acentos y tablas legibles en la terminal integrada de Windows
  "terminal.integrated.env.windows": { "PYTHONUTF8": "1", "PYTHONUNBUFFERED": "1" },
  "terminal.integrated.env.linux": { "PYTHONUTF8": "1", "PYTHONUNBUFFERED": "1" },
  "terminal.integrated.env.osx": { "PYTHONUTF8": "1", "PYTHONUNBUFFERED": "1" },

  // data/ tiene cientos de miles de archivos: fuera del explorador y de las búsquedas
  "files.exclude": { "**/__pycache__": true, "**/*.egg-info": true, "**/.pytest_cache": true },
  "search.exclude": { "data/**": true, "logs/**": true, ".venv/**": true },
  "files.watcherExclude": { "**/data/**": true, "**/logs/**": true, "**/.venv/**": true },

  "files.encoding": "utf8",
  "files.eol": "\n",
  "[python]": { "editor.rulers": [120], "editor.tabSize": 4 },
  "[powershell]": { "files.eol": "\r\n" },
  "[bat]": { "files.eol": "\r\n" }
}
